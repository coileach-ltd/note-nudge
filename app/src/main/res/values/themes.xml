<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NoteNudge" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#050505</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.NoteNudge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#009688</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#009688</item>
        <item name="postSplashScreenTheme">@style/Theme.NoteNudge</item>
    </style>

</resources>
